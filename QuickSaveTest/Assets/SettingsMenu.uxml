<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="UI Toolkit/Workshop.uss" />
    <ui:VisualElement class="screen screen--menu">

        <ui:VisualElement name="MainPanel" class="panel">
            <ui:Label text="Treasure Hunter" class="title" />
            <ui:Button name="ContinueButton" text="Continue" />
            <ui:Button name="NewGameButton" text="New Game" />
            <ui:Button name="LoadButton" text="Load Game" />
            <ui:Button name="QuitButton" text="Quit" />
            <ui:Label name="MessageLabel" class="message" />
        </ui:VisualElement>

        <ui:VisualElement name="NewGamePanel" class="panel hidden">
            <ui:Label text="New Game" class="title" />
            <ui:Label text="What is your name?" />
            <ui:TextField name="NameInput" />
            <ui:Button name="StartButton" text="Start" />
            <ui:Button name="NewGameBackButton" text="Back" />
        </ui:VisualElement>

        <ui:VisualElement name="LoadPanel" class="panel hidden">
            <ui:Label text="Load Game" class="title" />
            <ui:ScrollView name="SlotList" class="slot-list" />
            <ui:Button name="LoadBackButton" text="Back" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
